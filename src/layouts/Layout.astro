---
import "../styles/global.css";
const { title, description, faqJsonLd = null } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, "https://drozdskup.pl").href;

const localBusinessLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://drozdskup.pl/#business",
  name: "Drozd Skup Złomu i Sprzedaż Kruszywa",
  image: "https://drozdskup.pl/img/tlo3.webp",
  url: "https://drozdskup.pl",
  telephone: "+48502732306",
  email: "kontakt@drozdskup.pl",
  address: {
    "@type": "PostalAddress",
    streetAddress: "ul. Starzyńskiego 15",
    addressLocality: "Police",
    postalCode: "72-010",
    addressCountry: "PL",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: "53.5487",
    longitude: "14.5695",
  },
  areaServed: [
    { "@type": "City", name: "Police" },
    { "@type": "City", name: "Szczecin" },
    "Police, Szczecin i okolice",
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "08:00",
      closes: "16:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: "Saturday",
      opens: "08:00",
      closes: "13:00",
    },
  ],
};
---

<!doctype html>
<html lang="pl" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Patryk Karlinski" />

    <meta
      name="keywords"
      content="skup złomu police, złom police, złomowisko police, odbiór złomu police, złomowanie police, piasek police, kruszywa police, skup złomu szczecin, złom metalowy, metale kolorowe"
    />

    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://drozdskup.pl/img/tlo3.webp" />
    <link
      rel="preload"
      as="image"
      href="/img/tlo3.webp"
      type="image/webp"
      fetchpriority="high"
    />

    <link rel="icon" type="image/webp" href="/img/scrap.webp" />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessLd)}
    />
    {
      faqJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(faqJsonLd)}
        />
      )
    }
  </head>
  <body class="bg-white text-[#002333] font-sans antialiased pb-8 md:pb-0">
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <slot />
    </main>

    <a
      id="call-fab"
      href="tel:+48502732306"
      class="fixed bottom-5 right-4 z-50 md:hidden flex items-center justify-center w-14 h-14 bg-[#1AA3A5] hover:bg-[#2BB8BA] text-white rounded-full shadow-lg transition-colors"
      aria-label="Zadzwoń: 502 732 306"
    >
      <svg
        class="w-6 h-6"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
        ></path>
      </svg>
    </a>

    <footer
      class="w-full text-center py-10 mt-12 border-t border-gray-200 pb-6 md:pb-10"
    >
      <div class="text-2xl font-bold text-[#002333] mb-2">
        Drozd · Skup Złomu
      </div>
      <p class="text-sm md:text-base text-slate-600 font-medium mb-3">
        ul. Starzyńskiego 15, 72-010 Police · Tel.{" "}
        <a
          href="tel:+48502732306"
          class="text-teal-700 font-semibold hover:text-[#002333] transition-colors underline-offset-2 hover:underline"
          >502 732 306</a
        >
      </p>
      <p class="text-sm text-gray-600 font-medium">
        &copy; {new Date().getFullYear()} Drozd Skup Złomu Police. Wszelkie prawa
        zastrzeżone. |
        <a
          href="/polityka-cookies"
          class="text-[#0f7a7c] font-bold hover:text-[#002333] transition-colors underline-offset-4 hover:underline"
          >Polityka Cookies</a
        >
      </p>
    </footer>
    <div
      id="cookie-banner"
      class="fixed bottom-0 left-0 w-full bg-[#002333] text-white p-4 md:p-6 z-[200] flex flex-col sm:flex-row justify-between items-center gap-4 shadow-[0_-10px_40px_rgba(0,0,0,0.3)] hidden"
    >
      <div class="text-sm md:text-base text-center sm:text-left text-gray-300">
        Ta strona wykorzystuje pliki cookies m.in. do prawidłowego działania
        mapy dojazdu. Więcej informacji znajdziesz w naszej <a
          href="/polityka-cookies"
          class="text-[#159A9C] font-bold hover:text-white transition-colors underline underline-offset-4"
          >Polityce Cookies</a
        >.
      </div>
      <button
        id="accept-cookies"
        class="bg-[#1AA3A5] hover:bg-white hover:text-[#002333] text-white font-bold py-3 px-8 rounded-full whitespace-nowrap transition-colors shadow-lg shrink-0"
      >
        Rozumiem
      </button>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const banner = document.getElementById("cookie-banner");
        const acceptBtn = document.getElementById("accept-cookies");
        const callFab = document.getElementById("call-fab");

        if (!localStorage.getItem("cookiesAccepted")) {
          banner?.classList.remove("hidden");
          // Baner cookies zasłania FAB — chowamy go do akceptacji (bez zmiany layoutu strony)
          callFab?.classList.add("hidden");
        }

        if (acceptBtn && banner) {
          acceptBtn.addEventListener("click", () => {
            localStorage.setItem("cookiesAccepted", "true");
            banner.classList.add("hidden");
            callFab?.classList.remove("hidden");
          });
        }

        // Chrome + scroll-smooth: kotwice typu /oferta#piasek często nie scrollują na desktopie
        const scrollToHash = () => {
          const id = decodeURIComponent(window.location.hash.slice(1));
          if (!id) return;
          const el = document.getElementById(id);
          if (!el) return;
          el.scrollIntoView({ behavior: "auto", block: "start" });
        };

        if (window.location.hash) {
          requestAnimationFrame(() => {
            scrollToHash();
            // drugi pass po layoutcie (obrazy / fonty)
            window.setTimeout(scrollToHash, 100);
          });
        }
      });
    </script>
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-XC4C809WPQ"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "G-XC4C809WPQ");
      gtag("config", "AW-877625419");
    </script>
  </body>
</html>
