---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Drozd Skup Złomu Police - Złom, Piasek, Kruszywa"
  description="DROZD SKUP ZŁOMU I SPRZEDAŻ KRUSZYWA, KAMIENI, GRANITU POLICE. Najlepsze ceny, szybki transport na miejsce."
>
  <nav
    class="sticky top-4 bg-white rounded-full shadow-md z-50 py-3 px-5 sm:py-4 sm:px-8 flex justify-between items-center mb-8"
  >
    <a href="/" class="flex items-center gap-3 sm:gap-4 shrink-0">
      <img
        src="/img/scrap.webp"
        alt="Drozd Logo"
        class="w-14 h-14 sm:w-16 sm:h-16 object-contain"
      />
      <span
        class="text-2xl sm:text-4xl lg:text-4xl font-black text-[#002333] whitespace-nowrap tracking-tight leading-none"
      >
        Drozd <span class="text-[#159A9C]">| Skup Złomu</span>
      </span>
    </a>

    <ul
      class="hidden lg:flex gap-8 xl:gap-12 text-xl xl:text-2xl font-bold text-[#002333]"
    >
      <li>
        <a href="#zlom" class="hover:text-[#159A9C] transition-colors">Złom</a>
      </li>
      <li>
        <a href="#piasek" class="hover:text-[#159A9C] transition-colors"
          >Piasek</a
        >
      </li>
      <li>
        <a href="/oferta" class="hover:text-[#159A9C] transition-colors"
          >Oferta</a
        >
      </li>
      <li>
        <a href="#contact" class="hover:text-[#159A9C] transition-colors"
          >Kontakt</a
        >
      </li>
    </ul>

    <div class="flex items-center gap-4 shrink-0">
      <a
        href="tel:502732306"
        class="hidden lg:block bg-red-600 text-white px-8 py-3 rounded-full font-bold text-lg hover:bg-red-700 transition-transform hover:scale-105 shadow-md whitespace-nowrap"
        >Zadzwoń</a
      >

      <button
        id="mobile-menu-btn"
        class="lg:hidden p-1 text-[#002333] hover:text-[#159A9C] focus:outline-none transition-colors"
        aria-label="Otwórz menu"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-12 w-12 sm:h-14 sm:w-14"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <header
    class="relative bg-[#002333] text-white rounded-[40px] overflow-hidden mb-10 shadow-2xl mt-4"
  >
    <div class="absolute inset-0 opacity-40 mix-blend-overlay">
      <img
        src="/img/tlo3.webp"
        alt="Tło złomowiska"
        class="w-full h-full object-cover"
        fetchpriority="high"
      />
    </div>

    <div
      class="relative z-10 p-10 md:p-20 lg:p-24 text-center md:text-left flex flex-col md:w-2/3"
    >
      <h1
        class="text-5xl md:text-6xl lg:text-7xl font-black mb-6 leading-tight tracking-tight"
      >
        Twój zaufany <span class="text-[#159A9C]">skup złomu</span> w Policach
      </h1>
      <p class="text-xl mb-10 text-gray-300 font-light max-w-2xl">
        Najlepsze ceny, uczciwa waga i błyskawiczny transport. Pozbądź się
        zalegającego metalu lub zamów najwyższej jakości kruszywa prosto na
        budowę.
      </p>
      <div
        class="flex flex-col sm:flex-row gap-4 justify-center md:justify-start"
      >
        <a
          href="tel:502732306"
          class="bg-red-600 hover:bg-red-700 text-white px-8 py-4 rounded-full font-bold text-lg transition-transform duration-300 hover:scale-105 shadow-lg shadow-red-600/30 text-center"
          >📞 Zadzwoń po wycenę</a
        >
        <a
          href="https://maps.app.goo.gl/BZ1tgPHYC2gcyn8u6"
          target="_blank"
          class="bg-white/10 hover:bg-white/20 backdrop-blur-md text-white px-8 py-4 rounded-full font-bold text-lg transition-colors border border-white/20 text-center"
          >📍 Jak dojechać?</a
        >
      </div>
    </div>
  </header>

  <section id="zlom" class="py-10 md:py-16 max-w-7xl mx-auto px-4 sm:px-6">
    <div
      class="relative rounded-[40px] md:rounded-[60px] overflow-hidden shadow-2xl bg-[#002333]"
    >
      <img
        src="/img/tlo4.webp"
        alt="Skup Złomu"
        class="absolute inset-0 w-full h-full object-cover opacity-50 mix-blend-overlay"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-to-br from-[#002333] via-[#002333]/80 to-transparent"
      >
      </div>

      <div
        class="relative z-10 p-8 md:p-16 lg:p-20 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <div class="text-center lg:text-left">
          <h2
            class="text-5xl md:text-7xl font-black text-white mb-6 leading-tight tracking-tight"
          >
            Skup<br /><span class="text-[#159A9C]">Złomu</span>
          </h2>
          <p
            class="text-xl md:text-2xl text-gray-300 font-light mb-10 max-w-lg mx-auto lg:mx-0 leading-relaxed"
          >
            Najlepsze ceny w regionie. Posiadamy legalizowaną wagę, płacimy od
            ręki i gwarantujemy uczciwą klasyfikację surowca.
          </p>
          <a
            href="/oferta"
            class="inline-block bg-[#0E7A7C] text-white px-10 py-5 rounded-full font-bold text-lg hover:bg-white hover:text-[#002333] transition-colors shadow-lg"
          >
            📄 Zobacz pełną ofertę
          </a>
        </div>

        <div class="flex flex-col gap-6 text-center lg:text-left">
          <div
            class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 md:p-10 border border-white/10 shadow-2xl hover:bg-white/20 transition-colors"
          >
            <h3
              class="text-2xl font-bold text-white mb-4 flex items-center justify-center lg:justify-start gap-3"
            >
              <span class="text-3xl">⚙️</span> Złom stalowy
            </h3>
            <ul
              class="list-disc list-inside text-gray-300 text-lg leading-relaxed space-y-2 marker:text-[#159A9C]"
            >
              <li>Złom ciężki i lekki</li>
              <li>Blachy i żeliwo</li>
              <li>Stal wsadowa i niewsadowa</li>
              <li>Konstrukcje (każdy gabaryt)</li>
            </ul>
          </div>

          <div
            class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 md:p-10 border border-white/10 shadow-2xl hover:bg-white/20 transition-colors"
          >
            <h3
              class="text-2xl font-bold text-white mb-4 flex items-center justify-center lg:justify-start gap-3"
            >
              <span class="text-3xl">🔋</span> Metale kolorowe
            </h3>
            <ul
              class="list-disc list-inside text-gray-300 text-lg leading-relaxed space-y-2 marker:text-[#159A9C]"
            >
              <li>Miedź, mosiądz, brąz</li>
              <li>Aluminium i puszki po napojach</li>
              <li>Ołów i cynk</li>
              <li>Akumulatory ołowiowe</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="piasek" class="py-10 md:py-16 max-w-7xl mx-auto px-4 sm:px-6">
    <div
      class="relative rounded-[40px] md:rounded-[60px] overflow-hidden shadow-2xl bg-[#002333]"
    >
      <img
        src="/img/tlo2.webp"
        alt="Transport piasku i kruszywa"
        class="absolute inset-0 w-full h-full object-cover opacity-50 mix-blend-overlay"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-to-bl from-[#002333] via-[#002333]/80 to-transparent"
      >
      </div>

      <div
        class="relative z-10 p-8 md:p-16 lg:p-20 grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center"
      >
        <div class="order-1 lg:order-2 text-center lg:text-right">
          <h2
            class="text-6xl md:text-8xl font-black text-white mb-6 leading-tight tracking-tight"
          >
            Piaski<br /><span
              class="text-[#159A9C] text-4xl md:text-5xl uppercase tracking-wider font-bold italic opacity-90 block mt-2"
              >Szybki transport</span
            >
          </h2>
          <p
            class="text-xl md:text-2xl text-gray-300 font-light mb-10 max-w-lg mx-auto lg:ml-auto lg:mr-0 leading-relaxed"
          >
            Zapewniamy profesjonalny dowóz kruszyw własnymi wywrotkami.
            Obsługujemy duże place budowy oraz prywatne posesje.
          </p>
          <a
            href="/oferta"
            class="inline-block bg-[#0E7A7C] text-white px-10 py-5 rounded-full font-bold text-lg hover:bg-white hover:text-[#002333] transition-colors shadow-lg"
          >
            📄 Pełna oferta
          </a>
        </div>

        <div
          class="flex flex-col gap-6 order-2 lg:order-1 text-center lg:text-left"
        >
          <div
            class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 md:p-10 border border-white/10 shadow-2xl hover:bg-white/20 transition-colors"
          >
            <h3
              class="text-2xl font-bold text-white mb-4 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3"
            >
              <span class="text-4xl">🏖️</span>
              <span>Różne rodzaje piasku</span>
            </h3>
            <ul
              class="list-disc list-inside text-gray-300 text-lg leading-relaxed space-y-2 marker:text-[#159A9C]"
            >
              <li>Piasek płukany (0-2 mm)</li>
              <li>Piasek do wylewek i murowania</li>
              <li>Piasek zasypowy na fundamenty</li>
              <li>Czysty piasek do piaskownic</li>
            </ul>
          </div>

          <div
            class="bg-white/10 backdrop-blur-xl rounded-3xl p-8 md:p-10 border border-white/10 shadow-2xl hover:bg-white/20 transition-colors"
          >
            <h3
              class="text-2xl font-bold text-white mb-4 flex items-center justify-center lg:justify-start gap-3"
            >
              <span class="text-3xl">🪨</span> Żwiry i Kruszywa
            </h3>
            <ul
              class="list-disc list-inside text-gray-300 text-lg leading-relaxed space-y-2 marker:text-[#159A9C]"
            >
              <li>Żwiry płukane (2-8, 8-16, 16-32 mm)</li>
              <li>Kruszywa łamane</li>
              <li>Tłuczeń drogowy</li>
              <li>Mieszanki podbudowowe</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section
    id="contact"
    class="py-10 md:py-16 max-w-5xl mx-auto w-full px-4 sm:px-6 mb-10"
  >
    <div class="text-center mb-8 md:mb-10">
      <h2 class="text-4xl md:text-5xl font-black text-[#002333]">
        Kontakt i Dojazd
      </h2>
      <p
        class="text-lg md:text-xl font-medium text-[#002333]/70 mt-3 max-w-2xl mx-auto"
      >
        Masz pytania? Zadzwoń lub odwiedź nasz plac.
      </p>
    </div>

    <div
      class="bg-[#002333] text-white rounded-[40px] p-8 md:p-12 lg:p-16 shadow-2xl relative overflow-hidden w-full"
    >
      <div
        class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 text-center relative z-10 mb-12"
      >
        <div class="flex flex-col items-center justify-start">
          <h3
            class="text-sm md:text-base text-gray-400 font-bold mb-4 uppercase tracking-widest"
          >
            Godziny otwarcia
          </h3>
          <p class="text-xl md:text-2xl font-bold text-[#159A9C]">
            Pon-pt: 8:00 - 15:00
          </p>
          <p class="text-xl md:text-2xl font-bold text-[#159A9C]">
            Sobota: 8:00 - 13:00
          </p>
        </div>
        <div
          class="flex flex-col items-center justify-start border-y lg:border-y-0 lg:border-x border-white/10 py-8 lg:py-0"
        >
          <h3
            class="text-sm md:text-base text-gray-400 font-bold mb-4 uppercase tracking-widest"
          >
            Zadzwoń
          </h3>
          <a
            href="tel:502732306"
            class="text-3xl font-black text-red-500 hover:text-red-400 block"
            >502-732-306</a
          >
        </div>
        <div class="flex flex-col items-center justify-start">
          <h3
            class="text-sm md:text-base text-gray-400 font-bold mb-4 uppercase tracking-widest"
          >
            Napisz
          </h3>
          <a
            href="mailto:kontakt@drozdskup.pl"
            class="text-xl md:text-2xl font-bold text-[#159A9C]"
            >kontakt@drozdskup.pl</a
          >
        </div>
      </div>

      <div class="border-t border-white/10 pt-10 relative z-10 mb-10">
        <div
          class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-12 text-center lg:text-left"
        >
          <div class="flex flex-col items-center lg:items-start">
            <h4
              class="text-sm text-gray-400 font-bold mb-2 uppercase tracking-widest"
            >
              Dane Firmy
            </h4>
            <p class="text-white text-lg font-medium leading-relaxed">
              DROZD SKUP ZŁOMU I SPRZEDAŻ KRUSZYWA<br />
              <span class="text-gray-400 text-base">NIP: 8512398671</span>
            </p>
          </div>

          <div class="hidden lg:block"></div>

          <div class="flex flex-col items-center lg:items-start">
            <h4
              class="text-sm text-gray-400 font-bold mb-2 uppercase tracking-widest"
            >
              Adres
            </h4>
            <p>
              <a
                href="https://maps.google.com/?q=Stefana+Starzyńskiego+15,72-010+Police"
                target="_blank"
                class="text-[#159A9C] font-bold text-xl md:text-2xl hover:text-white transition-colors"
              >
                ul. Starzyńskiego 15, 72-010 Police
              </a>
            </p>
          </div>
        </div>
      </div>

      <div
        class="w-full h-80 lg:h-[450px] rounded-3xl overflow-hidden border-4 border-white/10 bg-gray-900 shadow-2xl relative z-10"
      >
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3705.750615600689!2d14.56062041432215!3d53.55615097267938!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47aa735ab02af1a5%3A0x8bef0b99b30eff06!2sDROZD%20SKUP%20Z%C5%81OMU%20I%20SPRZEDA%C5%BB%20PIASKU%20KRUSZYWA%2CKAMIENI%2CGRANITU%20POLICE!5e1!3m2!1spl!2spl!4v1771867801792!5m2!1spl!2spl"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa dojazdu do Drozd Skup Złomu Police"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa dojazdu do Drozd Skup Złomu Police"
        >
        </iframe>
      </div>
    </div>
  </section>

  <div
    id="mobile-menu"
    class="fixed inset-0 bg-[#002333]/95 z-[100] hidden flex-col items-center justify-center backdrop-blur-md transition-opacity"
  >
    <button
      id="close-menu-btn"
      class="absolute top-8 right-8 text-white hover:text-red-500 p-2 transition-colors"
      aria-label="Zamknij menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="h-12 w-12"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <ul class="flex flex-col gap-12 text-center text-5xl font-black text-white">
      <li class="py-4">
        <a
          href="#zlom"
          class="mobile-link hover:text-[#159A9C] transition-colors">Złom</a
        >
      </li>
      <li class="py-4">
        <a
          href="#piasek"
          class="mobile-link hover:text-[#159A9C] transition-colors">Piasek</a
        >
      </li>
      <li class="py-4">
        <a
          href="/oferta"
          class="mobile-link hover:text-[#159A9C] transition-colors">Oferta</a
        >
      </li>
      <li class="py-4">
        <a
          href="#contact"
          class="mobile-link hover:text-[#159A9C] transition-colors">Kontakt</a
        >
      </li>
    </ul>
    <a
      href="tel:502732306"
      class="mt-20 bg-red-600 text-white px-16 py-5 rounded-full font-bold text-3xl shadow-lg hover:bg-red-700 transition-colors"
      >📞 Zadzwoń</a
    >
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const btn = document.getElementById("mobile-menu-btn");
      const closeBtn = document.getElementById("close-menu-btn");
      const menu = document.getElementById("mobile-menu");
      const links = document.querySelectorAll(".mobile-link");

      function toggleMenu() {
        menu?.classList.toggle("hidden");
        menu?.classList.toggle("flex");
        document.body.classList.toggle("overflow-hidden");
      }

      if (btn && closeBtn && menu) {
        btn.addEventListener("click", toggleMenu);
        closeBtn.addEventListener("click", toggleMenu);

        links.forEach((link) => {
          link.addEventListener("click", toggleMenu);
        });
      }
    });
  </script>
</Layout>
