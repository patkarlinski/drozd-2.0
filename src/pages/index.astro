---
import Layout from "../layouts/Layout.astro";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Gdzie znajduje się skup złomu Drozd i w jakich godzinach pracujecie?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Nasz plac mieści się przy ul. Starzyńskiego 15 w Policach (wygodny wjazd również dla aut dostawczych i z przyczepką). Pracujemy od poniedziałku do piątku w godz. 8:00–15:00 oraz w soboty od 8:00 do 13:00.",
      },
    },
    {
      "@type": "Question",
      name: "Czy przyjmujecie mniejsze ilości złomu od osób prywatnych?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Tak, obsługujemy zarówno firmy, jak i klientów indywidualnych. Możesz przywieźć do nas każdą ilość materiału — od drobnych metali kolorowych (miedź, mosiądz, puszki aluminiowe, akumulatory) po stare grzejniki, rury, piece czy blachę po remoncie.",
      },
    },
    {
      "@type": "Question",
      name: "Jak wygląda wycena i płatność za przywieziony złom?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Surowiec ważymy na miejscu na legalizowanej wadze i uczciwie klasyfikujemy według aktualnego cennika. Za przywieziony złom płacimy od ręki gotówką lub szybkim przelewem (w zależności od ustaleń i rodzaju podmiotu).",
      },
    },
    {
      "@type": "Question",
      name: "Jakie dokumenty są potrzebne, żeby sprzedać złom?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Osoby prywatne potrzebują jedynie dokumentu tożsamości (dowodu osobistego) do spisania standardowego formularza przyjęcia metali. W przypadku firm rozliczamy się na podstawie faktury VAT oraz wpisu do systemu BDO.",
      },
    },
    {
      "@type": "Question",
      name: "Od jakiej ilości możliwy jest odbiór złomu z posesji lub firmy?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Odbiór złomu z posesji, budowy lub zakładu organizujemy przy większych partiach materiału. Zadzwoń do nas pod numer 502 732 306 — ocenimy ilość surowca i sprawnie ustalimy możliwości oraz termin wywozu.",
      },
    },
    {
      "@type": "Question",
      name: "Jak wygląda transport zamówionego piasku i kruszyw?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Na placu sprzedajemy piasek (płukany, zasypowy, do piaskownic), żwir oraz kruszywa budowlane i drogowe. Jeśli potrzebujesz dostawy na budowę lub posesję, zapewniamy bezpośredni kontakt do sprawdzonych kierowców z wywrotkami, z którymi szybko ustalisz koszt i termin dowozu.",
      },
    },
  ],
};
---

<Layout
  title="Skup złomu Police | Odbiór, złomowisko, piasek i kruszywa | Drozd"
  description="Skup złomu w Policach: legalizowana waga, płatność od ręki, odbiór złomu. Sprzedaż piasku i kruszyw z transportem. ul. Starzyńskiego 15 — zapraszamy."
  faqJsonLd={faqJsonLd}
>
  <nav
    class="sticky top-4 bg-white rounded-full shadow-md z-50 py-3 px-5 sm:py-4 sm:px-8 flex justify-between items-center mb-8"
  >
    <a href="/" class="flex items-center gap-3 sm:gap-4 shrink-0">
      <img
        src="/img/scrap.webp"
        alt="Drozd Logo"
        width="256"
        height="256"
        class="w-14 h-14 sm:w-16 sm:h-16 object-contain"
      />
      <span
        class="text-xl sm:text-3xl lg:text-3xl font-black text-[#002333] whitespace-nowrap tracking-tight leading-none"
      >
        Drozd <span class="text-[#159A9C]">| Skup Złomu</span>
      </span>
    </a>

    <ul
      class="hidden lg:flex gap-8 xl:gap-10 text-lg xl:text-xl font-bold text-[#002333]"
