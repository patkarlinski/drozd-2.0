          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Mapa dojazdu do Drozd Skup Złomu Police"
        >
        </iframe>
        <script>
          // Mapa dopiero gdy sekcja wchodzi w viewport — mniej JS na starcie
          document.addEventListener("DOMContentLoaded", () => {
            const frame = document.querySelector("#contact iframe[data-src]");
            if (!(frame instanceof HTMLIFrameElement) || !frame.dataset.src)
              return;
            const load = () => {
              if (!frame.dataset.src) return;
              frame.src = frame.dataset.src;
              delete frame.dataset.src;
            };
            if ("IntersectionObserver" in window) {
              const io = new IntersectionObserver(
                (entries) => {
                  if (entries.some((e) => e.isIntersecting)) {
                    load();
                    io.disconnect();
                  }
                },
                { rootMargin: "200px" },
              );
              io.observe(frame);
            } else {
              load();
            }
          });
        </script>
      </div>

